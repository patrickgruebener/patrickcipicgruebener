# Resend API Key für Kontaktformular
# Erhalte deinen Key auf https://resend.com/api-keys
# WICHTIG: Für Produktion einen eigenen Key erstellen!
RESEND_API_KEY=re_your_api_key_here

# Gehosteter Lemon-Squeezy-Checkout für das persönliche KI-System.
# Leer lassen, bis Produkt, Preis und Download im Checkout verifiziert sind.
# Ohne gültige HTTPS-URL bei Lemon Squeezy zeigt die Seite „Kauf anfragen“.
LEMON_SQUEEZY_CHECKOUT_URL=

# Private Lernchat. Generate a random key of at least 32 bytes and keep all
# secrets in Dokploy, never in source control.
LEARNING_CHAT_ACCESS_KEY=
OPENAI_API_KEY=
# USD to EUR conversion factor; update conservatively when reviewing API prices.
LEARNING_CHAT_USD_TO_EUR_RATE=
# Must point to a persistent Dokploy volume, e.g. /data/lernchat-budget.json.
LEARNING_CHAT_BUDGET_FILE=
